rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == 'ScFdYFy3Tbc20j2k2caQfNIM7Zu2';
    }
    function member() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hotelId == 'kingdavid'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function access() { return owner() || member(); }
    function manager() {
      return owner() || (member() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Boss']);
    }
    match /users/{uid} {
      allow read: if access() || (request.auth != null && request.auth.uid == uid);
      allow create: if manager() && request.resource.data.hotelId == 'kingdavid'
        && request.resource.data.role is string && request.resource.data.active is bool;
      allow update: if
        (manager() && (uid != 'ScFdYFy3Tbc20j2k2caQfNIM7Zu2' || owner())
          && request.resource.data.hotelId == resource.data.hotelId
          && request.resource.data.login == resource.data.login)
        || (access() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['color', 'theme', 'reminderDays'])
          && (!('color' in request.resource.data) || request.resource.data.color.matches('^#[a-fA-F0-9]{6}$'))
          && (!('theme' in request.resource.data) || request.resource.data.theme in ['light', 'cream', 'dark'])
          && (!('reminderDays' in request.resource.data) || request.resource.data.reminderDays in [3, 5]));
      // Account removal is performed by the authenticated callable function.
      allow delete: if false;
    }
    match /printTemplates/{templateId} {
      allow read: if access();
      allow write: if owner();
    }
    match /folders/{id} { allow read, write: if access(); }
    match /days/{dayId} {
      allow read, write: if access();
      match /notes/{noteId} {
        allow read, create, delete: if access();
        allow update: if access()
          && (!('author' in resource.data) || request.resource.data.author == resource.data.author)
          && (!('authorUid' in resource.data) || request.resource.data.authorUid == resource.data.authorUid);
        match /history/{eventId} {
          allow read: if access();
          allow create: if access() && request.resource.data.byUid == request.auth.uid
            && request.resource.data.action in ['Edited', 'Completed', 'Reopened', 'Rescheduled'];
          allow update, delete: if false;
        }
      }
    }
  }
}
